# ─────────────────────────────────────────────────────────────────────────────
# openspace — variables d'environnement. Copiez ce fichier en .env.local
# (local) et saisissez les mêmes valeurs dans Vercel (production).
# Ne commitez JAMAIS .env.local. Détail de chaque option : INSTALL.md et docs/.
# ─────────────────────────────────────────────────────────────────────────────

# ── Obligatoire ──────────────────────────────────────────────────────────────
# Supabase → Connect → « Session pooler » (port 5432, PAS 6543).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secrète : côté serveur uniquement, ne la montrez à personne.
SUPABASE_SERVICE_ROLE_KEY=
# L'adresse du CRM (http://localhost:3000 en local, l'URL Vercel en ligne).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Protège les tâches planifiées. Générez-la : openssl rand -hex 32
CRON_SECRET=

# ── Pays (Tunisie par défaut) ────────────────────────────────────────────────
NEXT_PUBLIC_APP_TIMEZONE=Africa/Tunis
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=216
NEXT_PUBLIC_NATIONAL_NUMBER_LENGTH=8

# ── Email (facultatif) — docs/email.md ───────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Mon école <noreply@mon-ecole.com>"
EMAIL_REPLY_TO=
# Plafond d'envoi par jour (100 sur le plan gratuit de Resend).
EMAIL_DAILY_LIMIT=100
RESEND_WEBHOOK_SECRET=
# Le domaine vérifié chez Resend ; vide = pas de contrôle de l'adresse d'expédition.
RESEND_SENDER_DOMAIN=

# ── WhatsApp, API Cloud de Meta (facultatif) — docs/whatsapp.md ─────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# dry_run (rien ne part) | allowlist (seulement les numéros de test) | live
WHATSAPP_SEND_MODE=dry_run
# Numéros de test, séparés par des virgules.
WHATSAPP_TEST_ALLOWLIST=
# Identifiant du formulaire d'inscription publié chez Meta ; vide = réponses texte.
WHATSAPP_FLOW_INSCRIPTION_ID=

# ── Assistant IA (facultatif) — docs/ia.md ───────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# ── Notifications sur téléphone (facultatif) — docs/notifications.md ─────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mon-ecole.com

# ── WordPress / Elementor / Tutor LMS (facultatif) — docs/wordpress.md ───────
WP_SITE_URL=
TUTOR_WEBHOOK_SECRET=
TUTOR_ALUMNI_BOOTCAMP=
TUTOR_ALUMNI_TAG=Alumni

# ── Avancé ───────────────────────────────────────────────────────────────────
# Délai maximal d'une requête SQL, en millisecondes (30000 par défaut).
DB_DELAI_MS=
